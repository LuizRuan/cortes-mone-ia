# Copie para .env. O Studio precisa de GROQ_API_KEY para criar os cortes.
# ANTHROPIC_API_KEY e opcional e pertence ao fluxo legado da CLI.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
CORTES_GROQ_WHISPER=whisper-large-v3-turbo
CORTES_GROQ_LLM=openai/gpt-oss-120b
CORTES_LLM_MODEL=claude-sonnet-5-5

# Porta publicada em todas as interfaces de rede do computador.
CORTES_PORT=7860

# Pasta do host montada somente para leitura em /entrada.
# No Windows, use barras normais: C:/Users/seu-usuario/Videos
CORTES_INPUT_DIR=./entrada

# IA local (gratuita, sem internet): CORTES_IA=local usa faster-whisper e Ollama.
# Sem CORTES_IA, usa o Groq quando GROQ_API_KEY existe e o modo local caso contrário.
CORTES_IA=local
CORTES_WHISPER_LOCAL=small
CORTES_OLLAMA_MODEL=qwen3:1.7b
CORTES_OLLAMA_URL=http://127.0.0.1:11434
CORTES_OLLAMA_CTX=8192