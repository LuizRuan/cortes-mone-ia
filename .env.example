# Copie para .env. As chaves sao opcionais; sem elas o processamento e local.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
CORTES_GROQ_WHISPER=whisper-large-v3-turbo
CORTES_GROQ_LLM=openai/gpt-oss-120b
CORTES_LLM_MODEL=claude-sonnet-5-5

# Porta publicada em todas as interfaces de rede do computador.
CORTES_PORT=7860

# Pasta do host montada somente para leitura em /entrada.
# No Windows, use barras normais: C:/Users/seu-usuario/Videos
CORTES_INPUT_DIR=./entrada
